 "poems": [
  {
   "seq": "1",
   "text": "春たつとしらてもみはや天の原霞むは今朝のおもひなしかと",
   "kana": "",
   "speaker": "小侍從集",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "あらたまる春はけさかと思ふより出る日影もめつらしきかな",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "とけぬなる覚の水のをとつれに春しりそむる深山への里",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "けふとてもうき身は春のよそなれは外に啼也鶯の聲",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "おる袖にしますもあるかな梅かゝの思ふ心のふかさはかりは",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "年ふともちらて櫻の花ならはめなれてかくやおしまさらまし",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "ちる花を吹上の濵の風ならはまたも梢にかへりさかせよ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "とへとこのしつをはすきぬ我身にもおはぬ櫻の花はいさとて",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "ともつれにこしその數もたらすしてなく〓〓今や歸鴈かね",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "身につもる年の暮にもまさり見けふはかりなる春のなけきは",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "おしみこし花の袂はそれなから浮身しかふるけふとならはや",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "いたつらに咲てやちらむ山賤の身の卯花はおりもしらねは",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "いかなれはそのかみ山の葵草としはふれとも二葉なるらん",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "夜もすからまたれ〓〓て時鳥聲ほの〓〓と啼わたる哉",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "早苗とる山田のぬしそおいにけるこん秋まての命いかにそ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "軒ちかき花たちはなはいにしへを忍ふの草のつまとこそみれ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "うつしうへぬこのくにならは見ましやは花橘はかく匂ふとも",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "夏くれはむろのやしまの里人も猶かやりひや思ひたつらん",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "けさみれはをの山かつもあれやこのせれうの里に立る蚊遣火",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "みそき河なかるゝみをの瀨にはやく身にしむ風は先立にけり",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "山田もるすこか麻衣ひとへにてけさたつ秋の風はいかにそ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "なか〓〓にこの夕暮やたなはたの思ふ心をつくしはつらむ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "萩か花おもけにみゆる露はかりちらさむ風はさもあらはあれ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "住吉とあとたれそめしそのかみに月や變らぬ今宵なるらん",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "いとふらんくめちの神の心まて思ひやらるゝ夜半の月かな",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "ふきをくる雲井の月のくもるまは我影たにもそはぬ旅かな",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "隈もなき月影うつすこよひこそおほろの〓水名そ替けれ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "はゝそはら時雨るまゝに常盤木の稀なりけるも今こそはみれ",
   "kana": "",
   "speaker": "小侍從集",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "限り有て秋はゆくとももみち散龍田の河にゑからみもかな",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "おりつれは松はわれとや思ふらんひまに紅葉の色をみむとて",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "けふ暮る秋のたかみやこれならんをくもあたなる露の白玉",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "初時雨ねさめの床にをとつれてもらぬに濡るかたしきのそて",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "草枕おなし旅ねの袖に又夜半の時雨も宿はかりけり",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "かき曇りあまきる雪のふる里をつもらぬさきにとふ人もかな",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "枝志けきふのたの森の陰のみやけふふる雪のつもらさるらん",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "みなかみや薄氷ならんさよ更てかけひにうつる水まれになる",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "山隱れ人もとひこぬ瀧水はつらゝにのみそ結はれにける",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "氷しく汀のひまやせはからんむれゐる鳥の飛わかれぬる",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "嵐にも尾上の鐘はひゝきけり霜はかりそと何思ひけむ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "み狩するかたのゝましは折しきて旅ねをすへきこよひ成けり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "かそふれは物うかるへきけふをしも年暮ぬとて何いそくらん",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "まつよひに更行かねの聲きけはあかぬわかれの鳥は物かは",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "君こふとうきぬる玉のさよ更ていかなるつまに結はれぬらん",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "朝〓とにかはる鏡の影みれば思はぬかけのかひもなきかな",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "思ひあまりみつのかしはにとふ〓との沈むにうくは涙成けり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "今こそはあふ夜にあふと見し夢をいはぬにいむと思ひあはすれ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "なからへはさりともとこそ思ひつれけふを我身の限成けり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "今こそは絕はてぬとも君ゆへにとまる心は身をもはなれし",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "たらちめは戀に命をかふへしと志らはや我をおほしたてけむ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "つれなさは君のみならすかくはかり思ふにたえぬ命有けり",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "いかにねしとさそや夢に見し事ばそれさへに社忘られにけれ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "賴むれはまつ夜の雨の明方になやむしもこそつらくきこゆる",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "さてをまれいはて思ひし心をは習はすなからありしはかりに",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "よきぬなりもとみし道を忘れねはあゆみとゝまる駒を早めて",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "さる澤の池になひきし玉藻こそかゝる歎のはてときゝしか",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "見し夢をきめめやかての現にてけふとたのめし暮をまたはや",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "箒木のありしふせやを思ふにもうかりし鳥の音こそ忘れね",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "人こゝろはなたの帶のされはこそかねて思ひしなかた(下圖)",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "いかなれはくちめる袖そ浪かゝるいはねの松もさて社はあれ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "恨見むもいつしかなれはあすよりはいはてや門の松と見えまし",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "嬉しくも戀路にまとふ足柄のうき世をそむくかたへ入ぬる",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "笛の音のよろつ代まてときこえしに山もこたふる心ちせし哉",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "萬代とはつねの笛になのらせて末をみかさの山やこたふる",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "生たゝん二葉の末を今年よりこはみくまのゝ若なとをしれ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "君か代はこしの里人かすそひてたえすそなふるみつき物かな",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "泊りゐて歸らぬけふの心をそうらやむ物と我は成ぬる",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "世のつねの住家をほらのうちにして歸らぬ人と君をなさはや",
   "kana": "",
   "speaker": "申宮權大夫時忠",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "かつまたの池にそたえしみつからをよそなる物と何思ひけん",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "かつまたのいけらむ限り忘れめやまた鳥のゐる世にかへる共",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "ならひにきあがぬ別の曉もかゝる名殘はなかりし物を",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "これそけにためしはあらめ古のあかぬ別は身をもうらみき",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "はかなさもあふ名なりけり夏のひもみる程有と覺えやはせし",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "思ひわひ絕る命もある物をあふ名のみやははかなかるへき",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "なかむらん同し月をは見る物をかはすに通ふ心なりせは",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "こよひ我とはれましやは月をみてかよふ心の空にしるくば",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "哀いつよかはの篝かけきえて有し思ひのはてときかれん",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "思へたゝこの言の葉をかへしてはなにゝかくへき露の命そ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "忘るゝはおなし浮名のこれはたゝくやしき〓とのそはぬ計そ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "くやしさのそふ計にもなれにせは忘るゝ迄にとはさらめやは",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "天つ星そらにはいかゝ定むらん思ひたゆへきけふの暮かは",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "人しれぬ心はさらにあくかれて思はぬ里の月をみしかな",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "雨ふれとわひつたれにし月影をいかなる里にさはなかめけむ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "まつらむとなにをしるしの杉にてか心もしらぬ宿をたつねん",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "人しらぬ心のうちの松のみそ杉にもまさるしるし成ける",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "深山木の賴みし影もかひなくてたまらぬ雨とふる淚かな",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "いとせめてまつは苦しき物そとは昔は君も思ひしりけむ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "なをさりにまつとはすとも君はよも更行鐘の聲はなけかし",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "嬉しとや神も心に石〓水にしきをきつゝかへるけしきを",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "思ひやれ誓ひし夜はのうきはしを錦たちきてかへる心を",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "さそふへき人とふならはしるへせよさてや思ひの家を出ると",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "したひみむ同しき和哥の浦千とり思ひ入げる末たかはすは",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "とへかしなうきよの中にあり〓〓て心とつけろ戀の病を",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "いかはいきしなはをくれし君ゆへに我もつきにし同し病を",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "とゝこほる春よりさきの山水を絕はてぬとや人はしるらん",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "とゝこほる程かときゝし山河の絕はてけるは春そしらるゝ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "いかたおろす杣山河の淺きせは又もさこそは暮のさはらめ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "きのふより淚落そふ杣河のけふはまされはくれもさはらす",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "雨雲の晴間に我もいてたるを月はかりをやめつらしとみる",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "雨の間に同し雲井をいてにけりもりこはなとか月にをとらむ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "君をなを秋こそはてね色かはる菊もみよかしひらけたにせぬ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "とふ人も波にたゝよふ海士小舟うらみは磯にこき歸りぬる",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "石〓水きよき流の末〓〓に我のみにこる名をすゝかはや",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "そむきにしまるしはいつら立歸りうき世にかくて墨染の袖",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "覺の世の夢にこの世を見るたにもうきは久しき歎ならすや",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "山水は結ふ氷によとみけりすきゆく年そせくかたもなき",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "色にのみ染し心のくやしきをむなしとゝける法のうれしさ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "君か代を何にたとへん二葉なる松もちとせの末を志らねは",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "うちそよく風なかりせはいかにしてよる我友を有とふらまし",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "あけぬとやねくらのたつは思ふらん月にしもふる松の玉枝を",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "咲にけり三笠の山の梢まてたのみをかくるふちの志るしは",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "君か代は菊のゑた水むすひける人のよはひもなにならぬかな",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "戀そめし心の色のいかなれは思ひかへすにかへらさるらん",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "いさやその開けぬ菊もたのまれす人の心のあきはてしより",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "開けぬを秋はてすとや見し菊の賴むかたなくうつろひにけり",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "移ろはゝ菊はかりをそ恨むへき我心にはあきしなけれは",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "よそにこそむやの蛤ふみゝしかあふとは海士の濡衣としれ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "ほのみつる門田の稻にひたはへてあか厭はすは又もゆかはや",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "いとふまて思ひなかけそ鳴子なは稻葉の風のまねく心を",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "かの岸へ渡りにけりなあまを舟すまはあふせをと思ひし物を",
   "kana": "",
   "speaker": "五條三位としなり",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "すみし世にあふせなかりし石〓水おりうれしくそ思ひ出たる",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "君はさはあまよの月か雲井より人にふられて山に入ける",
   "kana": "",
   "speaker": "ぬイ",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "すむかひもなくて雲井に有明の月は入とも何か志られむ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "思ひやれ八十の年の暮なれはいかはかりかほ物はひなしき",
   "kana": "",
   "speaker": "小侍從集",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "つゝきをも恨ぬ我にならふなようき身をしらぬ人もこそあれ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "しきみつむ山路の露にぬれにけり曉おきの黑染の袖",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "沖津風ふけ井の浦による波のよるとも見えす秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "いくめくり過行秋にあひぬらん變らぬ月の影をなかめて",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "雲となり雨と成ても身にそはゝ空しき空をかたみとやみむ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "きのみやは山井の〓水源しとてかへさもしらず日か暮すへき",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "待も見よあふ夜なたのお命にて我もーはしの心つよさを",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "咲にけり遠かた人にことゝひて名をしりそめし夕かほの花",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "諸共にあかわ別の衣〓〓にいつれの袖かぬれまきるらん",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "何〓とも夢ときくよにさめやらてうつゝに人を恨つる哉",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "賴めつゝこぬよを待し古を忍ふへしとは思ひやはせし",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "をとつれて猶過めるかいつくにも心をとめぬ初時雨かな",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "霜かれのあさち色つく冬野にはおはなそ秋のかたみ成ける",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "おもひやれ君か爲にと待花の咲もはてぬにいそくこゝろを",
   "kana": "",
   "speaker": "從三位賴政",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "あふ事を急かさりせはさきやらぬ花をはしはし待もしてまし",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "いさきよく月は心にすむ物としるこそ闇のはるゝ成けれ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "浪高きゆらのみなとをこく舟のしつめもあへぬ我心かな",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "住吉の神に祈りし逢とのまつも久しく成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "玉葉春下で歸りし春しなければと申て侍ける返事に",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "我爲におれや一枝山櫻家つとにとは思はすもあれ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "稀にあふ秋の七日のくれは鳥あやなくやかて明ぬこのよは",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "詠めても誰をかまたむ月夜よし夜よしと告む人しなけれは",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "跡つけしその昔こそ戀しけれのとかにつもる雪をみるにも",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "あひみむと急きし物を君はさは花ゆへのみや我をまちける",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "何〓とに露も心のとまらまし月をなかめぬ此世なりせは",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "朝夕の煙はかりをあるしにて人はをとせぬ大はらの里",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "おなし世にあるを賴みの命にておしむも誰かためとかはしる",
   "kana": "",
   "speaker": "雅二新千載ニ新拾遺四",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "今宵もや宿かりかれむ津國のこやとも人のいはぬわたりは",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "さそはれぬ心の程はつらけれと獨見るへき花の色かは",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "思ひこし夕くれなゐの儘ならてくやしや何のあくにあひけん",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "なひきける我身あさまの心からくゆる思ひに立煙かな",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "身のうきを思ひもしらぬ物ならは何かか戀のなくさめにせむ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
